<!-- Hero Section -->
<section id="home" class="hero">
    <div class="hero-content">
        <span class="hero-subtitle">GALAXY AI IS HERE</span>
        <h1>
            Experience <br>
            <span>Innovation.</span>
        </h1>
        <p class="hero-description">
            Powerful technology. Timeless design.<br>
            A smarter tomorrow, together.
        </p>
        <a href="#smartphones" class="btn-explore">
            Explore Now <span>→</span>
